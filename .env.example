# --- Shopify Storefront API ---
# Panel de Shopify > Settings > Apps and sales channels > Develop apps
# > Create an app > Configure Storefront API scopes (activa como minimo:
# unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_write_checkouts / unauthenticated_write_carts,
# unauthenticated_read_checkouts / unauthenticated_read_carts)
# > Install app > pestana "API credentials" > "Storefront API access token"
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Handle del producto "Impresion personalizada" que debes crear en Shopify
# (ver instrucciones en el README) para el flujo de "Imprime tu diseno".
SHOPIFY_CUSTOM_PRINT_PRODUCT_HANDLE=impresion-personalizada

# --- Subida de archivos (Vercel Blob) ---
# Panel de Vercel > tu proyecto > Storage > Create Database > Blob
# Copia el token generado (Connect > .env.local)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
